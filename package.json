{
  "name": "knowledge-graph-js",
  "version": "1.3.0",
  "description": "Yet another client for Google Knowledge Graph",
  "main": "index.js",
  "scripts": {
    "test": "xo && ava --verbose"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mycaule/knowledge-graph-js.git"
  },
  "author": "Michel Hua",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/mycaule/knowledge-graph-js/issues"
  },
  "homepage": "https://github.com/mycaule/knowledge-graph-js#readme",
  "devDependencies": {
    "ava": "^8.0.1",
    "natural": "^8.1.1",
    "patriarchy": "^1.0.8",
    "xo": "^4.0.0"
  },
  "xo": {
    "space": true,
    "semicolon": false,
    "rules": {
      "@stylistic/comma-dangle": ["error", "never"],
      "@stylistic/object-curly-newline": "off",
      "unicorn/prefer-module": "off",
      "unicorn/prefer-top-level-await": "off",
      "n/prefer-global/process": "off",
      "import-x/extensions": "off",
      "import-x/order": "off",
      "n/file-extension-in-import": "off",
      "unicorn/consistent-boolean-name": "off"
    }
  },
  "ava": {
    "snapshotDir": "snapshots"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "is-url": "^1.2.3",
    "superstruct": "^0.5.1"
  }
}
